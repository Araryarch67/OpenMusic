<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: neither the cloud backup nor a transfer to a new
     phone carries the YouTube Music session (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="youtube_music_account.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="youtube_music_account.json" />
    </device-transfer>
</data-extraction-rules>
